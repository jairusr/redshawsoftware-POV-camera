<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#2A3038"
    tools:ignore="Overdraw">

    <TextureView
        android:id="@+id/viture_preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/viture_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="16dp"
        android:background="#804A515C"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:text="@string/viture_searching"
        android:textColor="#FFFFFF"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/viture_recording_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:background="#B3C62845"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:text="@string/viture_recording_initial"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <Button
        android:id="@+id/viture_retry"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="@string/viture_retry"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="24dp"
        android:background="#804A515C"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="8dp"
        tools:ignore="ButtonStyle">

        <Button
            android:id="@+id/viture_photo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/viture_take_photo" />

        <Button
            android:id="@+id/viture_record"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/viture_start_recording" />
    </LinearLayout>
</FrameLayout>
